# Copy only on the VPS to .env.production, then replace every placeholder.
# Generate the database password and Payload secret separately as random hex.
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_HEX_PASSWORD
DATABASE_URL=postgresql://maplepath:REPLACE_WITH_DATABASE_HEX_PASSWORD@postgres:5432/maplepath
PAYLOAD_SECRET=REPLACE_WITH_SEPARATE_64_HEX_SECRET

# Match the tag built on the VPS or imported from another machine.
# Increment for later releases.
APP_IMAGE=maplepath-preview:preview-1

# The domain must point to this VPS before enabling the Caddy HTTPS profile.
SITE_ADDRESS=demo.example.com
SERVER_URL=https://demo.example.com
# Host port only; the application still listens on port 3000 inside its container.
WEB_BIND_PORT=3100
UPLOAD_DIR=/app/media

# Keep the preview protected, including the first administrator registration.
PREVIEW_USER=preview
# Use single quotes around the generated bcrypt hash to preserve dollar signs.
PREVIEW_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
